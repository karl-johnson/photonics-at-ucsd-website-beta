---
import { segments, type Range } from '../lib/scores';

interface Props {
  range: Range;
  size?: 'lg' | 'md' | 'sm';
}

const { range, size = 'lg' } = Astro.props;
---

<span class:list={['meter', `meter--${size}`]} aria-hidden="true">
  {segments(range).map((s) => <span class={s} />)}
</span>
