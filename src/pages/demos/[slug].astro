---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Meter from '../../components/Meter.astro';
import DocBody from '../../components/DocBody.astro';
import LoopVideo from '../../components/LoopVideo.astro';
import { resolveClip } from '../../lib/media';
import { PARAMETERS } from '../../data/parameters';
import { formatValue, type Range } from '../../lib/scores';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const demos = await getCollection('demos', (d) => !d.data.draft);
  return demos.map((demo) => ({ params: { slug: demo.id }, props: { demo } }));
}

const { demo } = Astro.props;
const d = demo.data;
const { Content, headings } = await render(demo);

const scoreRows = PARAMETERS.map((p) => {
  const range = (d.scores as Record<string, Range>)[p.key];
  return { label: p.name, value: formatValue(p.unit, range), range: p.unit === 'usd' ? null : range };
});

// Up to two photos below the scores, each shown at its own aspect ratio. An entry is a photo or a
// looping video clip (shown with its poster frame until it plays).
const photos = await Promise.all(
  d.photos.slice(0, 2).map(async (p) => {
    if ('video' in p) {
      const clip = resolveClip(demo.filePath!, p.video);
      const poster = (await getImage({ src: clip.poster, width: 896, format: 'webp' })).src;
      // The poster's size gives the clip its shape before the video itself loads.
      return { kind: 'video' as const, src: clip.src, poster, width: clip.poster.width, height: clip.poster.height, alt: p.alt };
    }
    return { kind: 'image' as const, src: p.src, alt: p.alt };
  }),
);
---

<Base title={d.title} description={d.subtitle} footerLink={{ label: '← All demos', href: '/' }}>
  {
    d.stub && (
      <div class="stub-banner" role="note">
        <div class="container">
          <span class="stub-banner-label">Stub</span>
          <p>This page is a stub. It will be expanded to a full guide in the future!</p>
        </div>
      </div>
    )
  }
  <section class="container demo-hero">
    <div class="demo-hero-main">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={withBase('/')}>Demos</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{d.title}</span>
      </nav>
      <h1 class="demo-title">{d.title}</h1>
      <p class="demo-subtitle">{d.subtitle}</p>
      {d.blurb && <p class="demo-blurb">{d.blurb}</p>}
      {
        d.diagram && (
          <div class="demo-diagram" id="diagram">
            {d.diagram.format === 'svg' ? (
              // SVG diagrams (made by `npm run diagrams`, text already turned into paths) are used as-is.
              <img src={d.diagram.src} width={d.diagram.width} height={d.diagram.height} alt={d.diagramAlt ?? ''} />
            ) : (
              <Image src={d.diagram} alt={d.diagramAlt ?? ''} widths={[648, 1296]} sizes="648px" loading="eager" />
            )}
          </div>
        )
      }
    </div>

    <div class="demo-side">
      <dl class="scores" aria-label="Attribute scores">
        {
          scoreRows.map((r) => (
            <div class="scores-row">
              <dt>{r.label}</dt>
              <dd>{r.range && <Meter range={r.range} />}</dd>
              <dd class="scores-value">{r.value}</dd>
            </div>
          ))
        }
      </dl>
      {
        photos.length > 0 && (
          <div class="demo-photos">
            {photos.map((p) => (
              <figure class="photo">
                {p.kind === 'video' ? (
                  <LoopVideo src={p.src} poster={p.poster} width={p.width} height={p.height} alt={p.alt} />
                ) : (
                  <Image
                    src={p.src}
                    alt={p.alt}
                    widths={[448, 896, 1344]}
                    sizes="(max-width: 719px) 100vw, (max-width: 1199px) 50vw, 448px"
                  />
                )}
              </figure>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <DocBody headings={headings}>
    <Content />
  </DocBody>
</Base>

<script>
  // Show an image's alt text next to the pointer as soon as it's over the diagram, a photo or a
  // video clip (a `title` tooltip only appears after a delay). Mouse only; hidden from screen
  // readers, which read the alt attribute (aria-label for videos) itself.
  const tip = document.createElement('div');
  tip.className = 'alt-tip';
  tip.setAttribute('aria-hidden', 'true');
  tip.hidden = true;
  document.body.append(tip);

  const place = (e: PointerEvent) => {
    const gap = 16;
    const { offsetWidth: w, offsetHeight: h } = tip;
    // Below-right of the pointer, flipped to the other side near the window's edges.
    let x = e.clientX + gap;
    let y = e.clientY + gap;
    if (x + w > innerWidth - 8) x = Math.max(8, e.clientX - gap - w);
    if (y + h > innerHeight - 8) y = Math.max(8, e.clientY - gap - h);
    tip.style.transform = `translate(${x}px, ${y}px)`;
  };

  document.querySelectorAll<HTMLElement>('.demo-diagram img, .photo img, .photo video').forEach((img) => {
    const text = (img instanceof HTMLImageElement ? img.alt : img.getAttribute('aria-label')) ?? '';
    if (!text.trim()) return;
    img.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      tip.textContent = text;
      tip.hidden = false;
      place(e);
    });
    img.addEventListener('pointermove', (e) => {
      if (!tip.hidden) place(e);
    });
    img.addEventListener('pointerleave', () => {
      tip.hidden = true;
    });
  });
</script>
