---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Meter from '../../components/Meter.astro';
import { PARAMETERS } from '../../data/parameters';
import { formatValue, type Range } from '../../lib/scores';
import { withBase } from '../../lib/url';
import { prepareInlineSvg } from '../../lib/svg';

// Raw text of every SVG in the demo folders, so SVG diagrams can be inlined (see src/lib/svg.ts).
const rawSvgs = import.meta.glob<string>('/src/content/demos/*/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

export async function getStaticPaths() {
  const demos = await getCollection('demos', (d) => !d.data.draft);
  return demos.map((demo) => ({ params: { slug: demo.id }, props: { demo } }));
}

const { demo } = Astro.props;
const d = demo.data;
const { Content, headings } = await render(demo);
const sections = headings.filter((h) => h.depth === 2);

const scoreRows = PARAMETERS.map((p) => {
  const range = (d.scores as Record<string, Range>)[p.key];
  return { label: p.name, value: formatValue(p.unit, range), range: p.unit === 'usd' ? null : range };
});

// An SVG diagram is inlined; find its file among this demo's SVGs by name. The processed image
// URL keeps the file name (dev: /@fs/…/setup.svg?…, build: /_astro/setup.<hash>.svg).
let diagramSvg: string | null = null;
if (d.diagram?.format === 'svg') {
  const match = Object.entries(rawSvgs).find(([path]) => {
    const [folder, file] = path.split('/').slice(-2);
    return folder === demo.id && d.diagram!.src.includes('/' + file.replace(/\.svg$/, '') + '.');
  });
  if (match) diagramSvg = prepareInlineSvg(match[1], d.diagramAlt ?? '');
}

// Two photo slots beside the diagram; empty slots show a placeholder until photos are added.
const photoSlots = [0, 1].map((i) => d.photos[i] ?? null);
---

<Base title={d.title} description={d.subtitle} footerLink={{ label: '← All demos', href: '/' }}>
  <section class="container demo-hero">
    <div class="demo-hero-main">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={withBase('/')}>Demos</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{d.title}</span>
      </nav>
      <h1 class="demo-title">{d.title}</h1>
      <p class="demo-subtitle">{d.subtitle}</p>
      {
        d.diagram && (
          <div class="demo-diagram" id="diagram">
            {diagramSvg ? (
              <Fragment set:html={diagramSvg} />
            ) : (
              <Image src={d.diagram} alt={d.diagramAlt ?? ''} widths={[648, 1296]} sizes="648px" loading="eager" />
            )}
          </div>
        )
      }
    </div>

    <div class="demo-side">
      <dl class="scores" aria-label="Attribute scores">
        {
          scoreRows.map((r) => (
            <div class="scores-row">
              <dt>{r.label}</dt>
              <dd>{r.range && <Meter range={r.range} />}</dd>
              <dd class="scores-value">{r.value}</dd>
            </div>
          ))
        }
      </dl>
      {
        photoSlots.map((p, i) =>
          p ? (
            <figure class="photo">
              <Image src={p.src} alt={p.alt} widths={[448, 896, 1344]} sizes="(max-width: 719px) 100vw, 448px" />
            </figure>
          ) : (
            <div class:list={['photo', 'placeholder', { 'placeholder--dark': i === 1 }]} aria-hidden="true">
              [PHOTO]
            </div>
          ),
        )
      }
    </div>
  </section>

  <div class="container demo-body">
    <!-- Narrower screens: a sticky bar that opens into the section list (replaces the sidebar) -->
    <details class="toc-bar">
      <summary>
        <span class="toc-bar-label">Contents</span>
        <span class="toc-bar-num">01</span>
        <span class="toc-bar-current">{sections[0]?.text}</span>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 4l4 4 4-4"></path></svg>
      </summary>
      <nav aria-label="On this page">
        {
          sections.map((s, i) => (
            <a href={`#${s.slug}`} data-toc-bar={s.slug}>
              <span>{String(i + 1).padStart(2, '0')}</span>
              {s.text}
            </a>
          ))
        }
      </nav>
    </details>
    <nav class="toc" aria-label="On this page">
      <span class="toc-label">Contents</span>
      {
        sections.map((s, i) => (
          <a href={`#${s.slug}`} data-toc={s.slug}>
            <span>{String(i + 1).padStart(2, '0')}</span>
            {s.text}
          </a>
        ))
      }
    </nav>
    <article class="doc">
      <Content />
    </article>
  </div>
</Base>

<script>
  // Highlight the Contents entry for the section currently being read, in both the sidebar (wide
  // screens) and the sticky bar (narrower screens).
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a[data-toc]')];
  const barLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc-bar a[data-toc-bar]')];
  const bar = document.querySelector<HTMLDetailsElement>('.toc-bar');
  const barNum = document.querySelector('.toc-bar-num');
  const barCurrent = document.querySelector('.toc-bar-current');
  const targets = links
    .map((a) => document.getElementById(a.dataset.toc!)?.closest('section'))
    .filter((s): s is HTMLElement => !!s);
  let shown = -1;

  function update() {
    const line = window.innerHeight * 0.3;
    let current = 0;
    targets.forEach((s, i) => {
      if (s.getBoundingClientRect().top <= line) current = i;
    });
    // At the very bottom, the last (possibly short) section counts as current.
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
      current = targets.length - 1;
    }
    if (current === shown) return;
    shown = current;
    links.forEach((a, i) => a.classList.toggle('is-active', i === current));
    barLinks.forEach((a, i) => a.classList.toggle('is-active', i === current));
    if (barNum) barNum.textContent = String(current + 1).padStart(2, '0');
    const link = links[current];
    if (barCurrent && link) {
      barCurrent.textContent = (link.textContent ?? '').replace(link.querySelector('span')?.textContent ?? '', '').trim();
    }
  }
  // Close the bar's list once a section is picked.
  barLinks.forEach((a) => a.addEventListener('click', () => bar?.removeAttribute('open')));
  update();
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
</script>
