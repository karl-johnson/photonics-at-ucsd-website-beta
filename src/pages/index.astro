---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Meter from '../components/Meter.astro';
import { PARAMETERS, PARAMETER_INFO } from '../data/parameters';
import { formatValue, type Range } from '../lib/scores';
import { withBase } from '../lib/url';

const demos = (await getCollection('demos', (d) => !d.data.draft)).sort(
  (a, b) => b.data.added.getTime() - a.data.added.getTime(),
);

// Everything the page (and its client script) needs about each demo.
const items = await Promise.all(
  demos.map(async (demo) => {
    const d = demo.data;
    const photo = d.thumbnail ?? d.photos[0]?.src;
    const src = photo ?? d.diagram;
    return {
      id: demo.id,
      href: withBase(`/demos/${demo.id}/`),
      title: d.title,
      subtitle: d.subtitle,
      added: d.added.toISOString().slice(0, 10),
      // format: 'webp' also rasterizes SVG diagrams, which would otherwise be copied at full size.
      img: src ? (await getImage({ src, width: 952, format: 'webp' })).src : null,
      thumb: src ? (await getImage({ src, width: 216, format: 'webp' })).src : null,
      isDiagram: !photo && !!d.diagram,
      ranges: d.scores as Record<string, Range>,
    };
  }),
);
type Item = (typeof items)[number];

const cellValue = (item: Item, p: (typeof PARAMETERS)[number], compact = false) =>
  formatValue(p.unit, item.ranges[p.key], compact);

const featured = items[0];
// Default plot axes. If a key here is ever removed from rubric.yaml, fall back to the first parameters.
const axisOrFallback = (key: string, i: number) => (PARAMETERS.some((p) => p.key === key) ? key : PARAMETERS[i].key);
const defaultX = axisOrFallback('budget', 0);
const defaultY = axisOrFallback('conceptComplexity', 1);
const labelOf = (key: string) => PARAMETERS.find((p) => p.key === key)!.name;
const chevronDown = 'M2 4l4 4 4-4';
const chevronUp = 'M2 8l4-4 4 4';
---

<Base>
  <div class="container">
    <h1 class="home-title">Demo Selector</h1>

    <section class="explorer" aria-label="Demo explorer">
      <div class="plot-frame">
        <div class="y-strip">
          <div class="y-dd-anchor">
            <div class="dd dd--y" data-axis="y">
              <button type="button" class="dd-button" aria-haspopup="listbox" aria-expanded="false">
                <span class="dd-axis">Y</span>
                <span class="dd-label">{labelOf(defaultY)}</span>
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d={chevronDown}></path></svg>
              </button>
              <ul class="dd-menu" role="listbox" aria-label="Y axis" hidden></ul>
            </div>
          </div>
        </div>
        <div class="y-ticks" aria-hidden="true"></div>
        <div class="plot" role="group" aria-label="Demos plotted by the selected parameters"></div>

        <div class="x-ticks" aria-hidden="true"></div>

        <div class="x-strip">
          <div class="dd dd--x" data-axis="x">
            <button type="button" class="dd-button" aria-haspopup="listbox" aria-expanded="false">
              <span class="dd-axis">X</span>
              <span class="dd-label">{labelOf(defaultX)}</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d={chevronUp}></path></svg>
            </button>
            <ul class="dd-menu" role="listbox" aria-label="X axis" hidden></ul>
          </div>
        </div>
      </div>

      {
        featured && (
          <a class="preview lift" href={featured.href} aria-label={`Open ${featured.title}`}>
            <div class:list={['preview-media', { 'is-diagram': featured.isDiagram }]}>
              {featured.img && <img src={featured.img} alt="" />}
            </div>
            <div class="preview-text">
              <h2 class="preview-title">{featured.title}</h2>
              <p class="preview-sub">{featured.subtitle}</p>
            </div>
            <div class="preview-attrs">
              {PARAMETERS.map((p) => (
                <div class="preview-attr">
                  <span class="preview-attr-label">{p.name}</span>
                  <div class="preview-attr-val">
                    {p.unit === 'usd' ? <span /> : <Meter range={featured.ranges[p.key]} size="md" />}
                    <span class="mono">{cellValue(featured, p)}</span>
                  </div>
                </div>
              ))}
            </div>
          </a>
        )
      }
    </section>

    <section class="all-demos" id="all" aria-labelledby="all-demos-title">
      <div class="all-demos-head">
        <div>
          <h2 id="all-demos-title">All demos</h2>
          <span class="mono">{items.length} {items.length === 1 ? 'demo' : 'demos'}</span>
        </div>
        <span class="mono muted hint">Click a column to sort</span>
      </div>

      <div style={`--params: ${PARAMETERS.length}`}>
        <div class="demo-grid list-head">
          <span></span>
          <span class="list-head-label">Demo</span>
          {
            PARAMETERS.map((p) => (
              <button type="button" class="sort-btn" data-sort={p.key} aria-pressed="false" title={`Sort by ${p.name}`}>
                <span>{p.short}</span>
                <span class="arrow" aria-hidden="true">↕</span>
              </button>
            ))
          }
          <button type="button" class="sort-btn" data-sort="added" aria-pressed="true" title="Sort by most recent">
            <span>Date added</span>
            <span class="arrow" aria-hidden="true">↓</span>
          </button>
        </div>

        <ol class="demo-list">
          {
            items.map((item) => (
              <li data-id={item.id}>
                <a class="demo-grid demo-row" href={item.href}>
                  <span class:list={['demo-thumb', { 'is-diagram': item.isDiagram }]}>
                    {item.thumb && <img src={item.thumb} alt="" loading="lazy" />}
                  </span>
                  <span class="demo-row-text">
                    <span class="demo-row-title">{item.title}</span>
                    <span class="demo-row-sub">{item.subtitle}</span>
                  </span>
                  {PARAMETERS.map((p) => (
                    <span class="demo-cell">
                      <span class="visually-hidden">{p.name}:</span>
                      <span class="mono">{cellValue(item, p, true)}</span>
                      {p.unit !== 'usd' && <Meter range={item.ranges[p.key]} size="sm" />}
                    </span>
                  ))}
                  <span class="demo-date">{item.added}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </div>

  <script type="application/json" id="demo-data" set:html={JSON.stringify({ items, parameters: PARAMETER_INFO, defaultX, defaultY }).replace(/</g, '\\u003c')} />
</Base>

<script>
  import { initSelector } from '../scripts/selector';
  initSelector();
</script>
